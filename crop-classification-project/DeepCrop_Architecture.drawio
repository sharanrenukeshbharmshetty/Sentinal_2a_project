        </mxCell>
        <mxCell id="html_templates" value="Flask HTML Templates&#xa;(Fallback UI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="frontend_group">
